{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mirsad.local/schemas/report-1.0.0.json",
  "title": "Uleravo scan report",
  "type": "object",
  "additionalProperties": false,
  "required": ["diagnostics", "findings", "scan", "scanner", "schemaVersion", "summary"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "scanner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "provenance": { "$ref": "#/$defs/provenance" },
    "scan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["durationMs", "filesScanned", "filesSkipped", "generatedAt", "id", "target"],
      "properties": {
        "durationMs": { "type": "integer", "minimum": 0 },
        "filesScanned": { "type": "integer", "minimum": 0 },
        "filesSkipped": { "type": "integer", "minimum": 0 },
        "generatedAt": { "type": "string", "format": "date-time" },
        "id": { "type": "string", "pattern": "^[a-f0-9]{24}$" },
        "target": { "type": "string", "minLength": 1 }
      }
    },
    "summary": { "$ref": "#/$defs/summary" },
    "findings": {
      "type": "array",
      "items": { "$ref": "#/$defs/finding" }
    },
    "diagnostics": {
      "type": "array",
      "items": { "$ref": "#/$defs/diagnostic" }
    }
  },
  "$defs": {
    "severity": { "enum": ["info", "low", "medium", "high", "critical"] },
    "confidence": { "enum": ["low", "medium", "high"] },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lockfiles", "scanInputSha256"],
      "properties": {
        "lockfiles": {
          "type": "array",
          "items": { "$ref": "#/$defs/lockfileProvenance" }
        },
        "package": { "$ref": "#/$defs/packageProvenance" },
        "repository": { "$ref": "#/$defs/repositoryProvenance" },
        "scanInputSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "lockfileProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "state"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "state": { "enum": ["hashed", "size-limit"] }
      },
      "allOf": [
        {
          "if": { "properties": { "state": { "const": "hashed" } } },
          "then": { "required": ["sha256"] }
        }
      ]
    },
    "packageProvenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      },
      "anyOf": [{ "required": ["name"] }, { "required": ["version"] }]
    },
    "repositoryProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "url"],
      "properties": {
        "commit": {
          "type": "string",
          "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
        },
        "url": { "type": "string", "format": "uri", "pattern": "^https://" }
      }
    },
    "standards": {
      "type": "object",
      "additionalProperties": false,
      "required": ["atlas", "cwe", "owasp"],
      "properties": {
        "atlas": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "cwe": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "owasp": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "column",
        "confidence",
        "evidence",
        "file",
        "fingerprint",
        "line",
        "message",
        "remediation",
        "ruleId",
        "severity",
        "standards",
        "title"
      ],
      "properties": {
        "column": { "type": "integer", "minimum": 1 },
        "endColumn": { "type": "integer", "minimum": 1 },
        "endLine": { "type": "integer", "minimum": 1 },
        "confidence": { "$ref": "#/$defs/confidence" },
        "evidence": { "type": "string" },
        "file": { "type": "string", "minLength": 1 },
        "fingerprint": { "type": "string", "pattern": "^[a-f0-9]{24}$" },
        "line": { "type": "integer", "minimum": 1 },
        "message": { "type": "string", "minLength": 1 },
        "remediation": { "type": "string", "minLength": 1 },
        "ruleId": { "type": "string", "pattern": "^MCP[0-9]{3}$" },
        "severity": { "$ref": "#/$defs/severity" },
        "standards": { "$ref": "#/$defs/standards" },
        "title": { "type": "string", "minLength": 1 }
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["message", "type"],
      "properties": {
        "file": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 },
        "type": { "enum": ["error", "warning"] }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["critical", "high", "info", "low", "medium", "total"],
      "properties": {
        "critical": { "type": "integer", "minimum": 0 },
        "high": { "type": "integer", "minimum": 0 },
        "info": { "type": "integer", "minimum": 0 },
        "low": { "type": "integer", "minimum": 0 },
        "medium": { "type": "integer", "minimum": 0 },
        "total": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
